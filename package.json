{
  "name": "opencharts",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Free, open-source candlestick charting app (TradingView-style)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --local --config worker/wrangler.toml",
    "worker:test": "node --experimental-strip-types --test worker/test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "wrangler": "^4.168.0"
  }
}
